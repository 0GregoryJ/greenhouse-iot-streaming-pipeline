
# Lightweight Python runtime.
FROM python:3.12-slim

# Avoid .pyc files and enable immediate log output.
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

# Install dependencies separately for Docker layer caching.
COPY requirements/live.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy only the application that this container needs.
COPY consumers/live/consumer.py consumer.py

# Run without root privileges.
RUN useradd --create-home appuser
USER appuser

CMD ["python", "consumer.py"]
