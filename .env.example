# Copy to .env on each host and fill in the blank values.
# Values marked "default" match the application defaults. Leave a variable out to use the default,
# but do not leave it set to an empty value: an empty value is still "set" and overrides the default.
# No secrets or credentials belong in Git; .env is git-ignored.

# --------------------------------------------------
# MQTT (Raspberry Pi gateway and Mac simulator)
# --------------------------------------------------
# Gateway ingestor (Pi) reads MQTT_USERNAME, MQTT_PASSWORD, MQTT_PORT, MQTT_TOPIC and always connects to localhost.
# Simulator (Mac) reads MQTT_HOST, MQTT_PORT, MQTT_USERNAME, MQTT_PASSWORD, MQTT_TOPIC.
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=greenhouse/telemetry

# --------------------------------------------------
# Kafka (all hosts)
# --------------------------------------------------
# Broker address reachable through Tailscale, for example <TAILSCALE_IP>:9092 (required)
KAFKA_BOOTSTRAP_SERVERS=

# Topic (default)
KAFKA_TOPIC=greenhouse.sensor-readings

# --------------------------------------------------
# Gateway SQLite -> Kafka producer (Raspberry Pi; defaults)
# --------------------------------------------------
KAFKA_BATCH_SIZE=100
KAFKA_RETRY_SECONDS=5
KAFKA_DELIVERY_TIMEOUT_MS=60000

# --------------------------------------------------
# Live Kafka -> Redis consumer (serving EC2; default)
# --------------------------------------------------
# Changing the group name replays the retained topic into Redis.
LIVE_KAFKA_CONSUMER_GROUP=greenhouse-live-dev

# --------------------------------------------------
# Historical Kafka -> S3 consumer (serving EC2)
# --------------------------------------------------
# Consumer group (default). Changing it re-archives the retained topic as new objects.
HISTORICAL_KAFKA_CONSUMER_GROUP=greenhouse-historical

# Flush a batch at this many events or this many seconds, whichever comes first (defaults)
HISTORICAL_BATCH_SIZE=240
HISTORICAL_FLUSH_SECONDS=300

# Destination bucket (required by the historical consumer). Objects are written under
# s3://<S3_BUCKET>/<S3_PREFIX>/year=YYYY/month=MM/day=DD/...
# AWS credentials come from the EC2 instance profile, not from this file.
S3_BUCKET=
S3_PREFIX=raw/sensor_events
AWS_REGION=us-east-2

# --------------------------------------------------
# FastAPI (serving EC2)
# --------------------------------------------------
# Browser origins allowed to call the API, comma-separated. The default is local development only;
# add the dashboard origin in production.
CORS_ORIGINS=http://localhost:5173
