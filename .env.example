# MQTT Connection and topic
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=

# Kafka broker reachable through Tailscale
KAFKA_BOOTSTRAP_SERVERS=

# Kafka topic
