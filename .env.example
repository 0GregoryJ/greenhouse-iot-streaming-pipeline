# Values below marked "default" match the application defaults.
# Leave a variable out to use the default, but do not leave it set to an empty value:
# an empty value is still "set" and overrides the default.

# MQTT (MQTT_USERNAME and MQTT_PASSWORD are used by the gateway ingestor and the simulator;
# MQTT_HOST, MQTT_PORT, and MQTT_TOPIC are used by the simulator only)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC=greenhouse/telemetry

# Kafka broker reachable through Tailscale, for example <TAILSCALE_IP>:9092 (required)
KAFKA_BOOTSTRAP_SERVERS=

# Kafka topic (default)
KAFKA_TOPIC=greenhouse.sensor-readings

# Live Kafka consumer group (default)
KAFKA_CONSUMER_GROUP=greenhouse-live-dev

# Gateway publisher settings (defaults)
KAFKA_BATCH_SIZE=100
KAFKA_RETRY_SECONDS=5

# Frontend origins allowed to call FastAPI from a browser, comma-separated (default is local development only;
# add the dashboard origin in production)
CORS_ORIGINS=http://localhost:5173
