# Greenhouse IoT Streaming Pipeline
# Apache Kafka - Single-node KRaft broker
# Deployed on AWS EC2, accessible through Tailscale
#
# TEMPLATE ONLY: Replace <TAILSCALE_IP> with the broker's
# private Tailscale address before deploying.
# Do not use this file directly without configuring the host.

# --------------------------------------------------
# Broker identity
# --------------------------------------------------

process.roles=broker,controller
node.id=1

# --------------------------------------------------
# Networking
# --------------------------------------------------

# Restrict Kafka client traffic to the Tailscale interface.
listeners=PLAINTEXT://<TAILSCALE_IP>:9092,CONTROLLER://127.0.0.1:9093

# Address advertised to Kafka producers and consumers.
advertised.listeners=PLAINTEXT://<TAILSCALE_IP>:9092

# --------------------------------------------------
# KRaft controller
# --------------------------------------------------

controller.listener.names=CONTROLLER
controller.quorum.bootstrap.servers=localhost:9093

listener.security.protocol.map=PLAINTEXT:PLAINTEXT,CONTROLLER:PLAINTEXT
inter.broker.listener.name=PLAINTEXT

# --------------------------------------------------
# Persistent storage
# --------------------------------------------------

# Kafka logs and KRaft metadata are stored on
# persistent EC2 EBS-backed storage.
log.dirs=/home/ubuntu/kafka-data

# --------------------------------------------------
# Single-broker development configuration
# --------------------------------------------------

num.partitions=1
default.replication.factor=1

offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1

# --------------------------------------------------
# Event retention
# --------------------------------------------------

# Retain Kafka events for 7 days by default.
# Topic-level overrides may take precedence.
log.retention.hours=168