[Unit]
Description=Greenhouse MQTT to SQLite Ingestion
Wants=network-online.target
After=network-online.target mosquitto.service
Requires=mosquitto.service

[Service]
Type=simple

# Run as the regular Pi user, not root.
User=greenhousepi
Group=greenhousepi

# Repository containing the gateway application and schema.
WorkingDirectory=/home/greenhousepi/greenhouse-iot-streaming-pipeline

# Use the project's Python virtual environment.
ExecStart=/home/greenhousepi/greenhouse-iot-streaming-pipeline/.venv/bin/python -u gateway/ingest.py

# Automatically recover from unexpected process termination.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target