[Unit]
Description=Greenhouse SQLite to Kafka Producer
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Service]
Type=simple

# Run as an unprivileged user
User=greenhousepi
Group=greenhousepi

WorkingDirectory=/home/greenhousepi/greenhouse-iot-streaming-pipeline

# Read pending SQLite events and publish them to AWS Kafka
ExecStart=/home/greenhousepi/greenhouse-iot-streaming-pipeline/.venv/bin/python -u /home/greenhousepi/greenhouse-iot-streaming-pipeline/gateway/kafka_producer.py

# Allow in-flight Kafka deliveries to complete during shutdown
TimeoutStopSec=90

# Restart after crashes or unexpected termination
Restart=on-failure
RestartSec=5

# Send logs to journald
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target