{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Greenhouse Sensor Event v2",
    "description": "Schema for individual greenhouse sensor measurements.",
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "integer",
        "const": 2
      },
      "event_id": {
        "type": "string",
        "format": "uuid"
      },
      "sensor_id": {
        "type": "string",
        "minLength": 1
      },
      "gateway_id": {
        "type": "string",
        "minLength": 1
      },
      "timestamp": {
        "type": "string",
        "format": "date-time"
      },
      "measurement_type": {
        "type": "string",
        "enum": [
          "soil_moisture",
          "soil_temperature",
          "air_temperature",
          "relative_humidity",
          "atmospheric_pressure"
        ]
      },
      "value": {
        "type": "number"
      },
      "unit": {
        "type": "string",
        "enum": [
          "raw_capacitance",
          "celsius",
          "percent",
          "hpa"
        ]
      }
    },
    "required": [
      "schema_version",
      "event_id",
      "sensor_id",
      "gateway_id",
      "timestamp",
      "measurement_type",
      "value",
      "unit"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "properties": {
            "measurement_type": {
              "const": "atmospheric_pressure"
            }
          },
          "required": ["measurement_type"]
        },
        "then": {
          "properties": {
            "unit": {
              "const": "hpa"
            }
          }
        }
      }
    ]
  }
  