
{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Greenhouse Sensor Event",
    "description": "Schema for individual greenhouse sensor measurements.",
    "type": "object",
    "properties": {
      "schema_version": {
        "type": "integer",
        "const": 1
      },
      "event_id": {
        "type": "string",
        "format": "uuid",
        "description": "Unique identifier for deduplication."
      },
      "sensor_id": {
        "type": "string",
        "minLength": 1
      },
      "gateway_id": {
        "type": "string",
        "minLength": 1
      },
      "timestamp": {
        "type": "string",
        "format": "date-time",
        "description": "UTC timestamp when the measurement was taken."
      },
      "measurement_type": {
        "type": "string",
        "enum": [
          "soil_moisture",
          "soil_temperature",
          "air_temperature",
          "relative_humidity"
        ]
      },
      "value": {
        "type": "number"
      },
      "unit": {
        "type": "string",
        "enum": [
          "raw_capacitance",
          "celsius",
          "percent"
        ]
      }
    },
    "required": [
      "schema_version",
      "event_id",
      "sensor_id",
      "gateway_id",
      "timestamp",
      "measurement_type",
      "value",
      "unit"
    ],
    "additionalProperties": false
  }
  