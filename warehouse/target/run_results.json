d": true, "compiled_code": "\n    \n    \n\nselect\n    event_id as unique_field,\n    count(*) as n_records\n\nfrom GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_intermediate.int_sensor_readings\nwhere event_id is not null\ngroup by event_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-10T08:39:45.293204Z", "completed_at": "2026-11-10T08:39:45.295718Z"}, {"name": "execute", "started_at": "2026-11-10T08:39:45.296111Z", "completed_at": "2026-11-10T08:39:46.696253Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 1.4039080142974854, "adapter_response": {"_message": "SUCCESS 66", "code": "SUCCESS", "rows_affected": 66, "query_id": "01c85067-0109-bec4-0012-a47e000a189e", "rows_inserted": 66, "rows_deleted": 0, "rows_updated": 0, "rows_duplicates": 0}, "message": "SUCCESS 66", "failures": null, "unique_id": "model.greenhouse_analytics.fct_sensor_daily", "compiled": true, "compiled_code": "\n\nWITH readings AS (\n    SELECT *\n    FROM GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_intermediate.int_sensor_readings\n),\n\ndaily AS (\n    SELECT\n        measurement_date_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type,\n        unit,\n\n        COUNT(*) AS reading_count,\n\n        AVG(value) AS avg_value,\n        MIN(value) AS min_value,\n        MAX(value) AS max_value,\n        STDDEV_SAMP(value) AS stddev_value,\n\n        MIN(measured_at_utc) AS first_measured_at_utc,\n        MAX(measured_at_utc) AS last_measured_at_utc\n\n    FROM readings\n\n    GROUP BY\n        measurement_date_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type,\n        unit\n)\n\nSELECT *\nFROM daily", "relation_name": "GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_marts.fct_sensor_daily", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-10T08:39:46.701971Z", "completed_at": "2026-11-10T08:39:46.706780Z"}, {"name": "execute", "started_at": "2026-11-10T08:39:46.707389Z", "completed_at": "2026-11-10T08:39:48.113653Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 1.413086175918579, "adapter_response": {"_message": "SUCCESS 1373", "code": "SUCCESS", "rows_affected": 1373, "query_id": "01c85067-0109-be37-0012-a47e000b25be", "rows_inserted": 1373, "rows_deleted": 0, "rows_updated": 0, "rows_duplicates": 0}, "message": "SUCCESS 1373", "failures": null, "unique_id": "model.greenhouse_analytics.fct_sensor_hourly", "compiled": true, "compiled_code": "\n\nWITH readings AS (\n    SELECT *\n    FROM GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_intermediate.int_sensor_readings\n),\n\nhourly AS (\n    SELECT\n        measurement_hour_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type,\n        unit,\n\n        COUNT(*) AS reading_count,\n\n        AVG(value) AS avg_value,\n        MIN(value) AS min_value,\n        MAX(value) AS max_value,\n        STDDEV_SAMP(value) AS stddev_value,\n\n        MIN(measured_at_utc) AS first_measured_at_utc,\n        MAX(measured_at_utc) AS last_measured_at_utc\n\n    FROM readings\n\n    GROUP BY\n        measurement_hour_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type,\n        unit\n)\n\nSELECT *\nFROM hourly", "relation_name": "GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_marts.fct_sensor_hourly", "batch_results": null, "overload_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-11-10T08:39:48.117745Z", "completed_at": "2026-11-10T08:39:48.121512Z"}, {"name": "execute", "started_at": "2026-11-10T08:39:48.122096Z", "completed_at": "2026-11-10T08:39:50.250733Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 2.1340441703796387, "adapter_response": {"_message": "SUCCESS 66", "code": "SUCCESS", "rows_affected": 66, "query_id": "01c85067-0109-bec4-0012-a47e000a18a2", "rows_inserted": 66, "rows_deleted": 0, "rows_updated": 0, "rows_duplicates": 0}, "message": "SUCCESS 66", "failures": null, "unique_id": "model.greenhouse_analytics.fct_sensor_quality_daily", "compiled": true, "compiled_code": "\n\nWITH audit_events AS (\n    SELECT\n        *,\n\n        COALESCE(\n            TO_DATE(\n                CONVERT_TIMEZONE('UTC', measured_at)\n            ),\n            TO_DATE(\n                CONVERT_TIMEZONE('UTC', loaded_at)\n            )\n        ) AS reporting_date_utc\n\n    FROM GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_intermediate.int_sensor_event_audit\n),\n\nquality_counts AS (\n    SELECT\n        reporting_date_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type,\n\n        COUNT(*) AS raw_record_count,\n\n        SUM(\n            IFF(is_duplicate, 1, 0)\n        ) AS duplicate_record_count,\n\n        SUM(\n            IFF(NOT is_valid, 1, 0)\n        ) AS invalid_record_count,\n\n        SUM(\n            IFF(\n                is_valid AND NOT is_duplicate,\n                1,\n                0\n            )\n        ) AS valid_unique_reading_count\n\n    FROM audit_events\n\n    GROUP BY\n        reporting_date_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type\n),\n\nreadings_with_previous AS (\n    SELECT\n        measurement_date_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type,\n        measured_at_utc,\n\n        LAG(measured_at_utc) OVER (\n            PARTITION BY\n                gateway_id,\n                sensor_id,\n                measurement_type\n\n            ORDER BY\n                measured_at_utc,\n                event_id\n        ) AS previous_measured_at_utc\n\n    FROM GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_intermediate.int_sensor_readings\n),\n\ndaily_gaps AS (\n    SELECT\n        measurement_date_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type,\n\n        MAX(\n            DATEDIFF(\n                'SECOND',\n                previous_measured_at_utc,\n                measured_at_utc\n            )\n        ) AS max_reading_gap_seconds\n\n    FROM readings_with_previous\n\n    GROUP BY\n        measurement_date_utc,\n        gateway_id,\n        sensor_id,\n        measurement_type\n)\n\nSELECT\n    q.reporting_date_utc AS measurement_date_utc,\n\n    q.gateway_id,\n    q.sensor_id,\n    q.measurement_type,\n\n    q.raw_record_count,\n    q.duplicate_record_count,\n    q.invalid_record_count,\n    q.valid_unique_reading_count,\n\n    g.max_reading_gap_seconds\n\nFROM quality_counts q\n\nLEFT JOIN daily_gaps g\n    ON q.reporting_date_utc = g.measurement_date_utc\n   AND q.gateway_id = g.gateway_id\n   AND q.sensor_id = g.sensor_id\n   AND q.measurement_type = g.measurement_type", "relation_name": "GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_marts.fct_sensor_quality_daily", "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-10T08:39:50.258299Z", "completed_at": "2026-11-10T08:39:50.262671Z"}, {"name": "execute", "started_at": "2026-11-10T08:39:50.263705Z", "completed_at": "2026-11-10T08:39:50.502872Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.2463512420654297, "adapter_response": {"_message": "SUCCESS 1", "code": "SUCCESS", "rows_affected": 1, "query_id": "01c85067-0109-bec4-0012-a47e000a18a6"}, "message": null, "failures": 0, "unique_id": "test.greenhouse_analytics.assert_unique_hourly_grain", "compiled": true, "compiled_code": "SELECT\n    measurement_hour_utc,\n    gateway_id,\n    sensor_id,\n    measurement_type,\n    unit,\n    COUNT(*) AS row_count\n\nFROM GREENHOUSE_ANALYTICS.GREENHOUSE_DBT_marts.fct_sensor_hourly\n\nGROUP BY 1, 2, 3, 4, 5\nHAVING COUNT(*) > 1", "relation_name": null, "batch_results": null, "overload_results": null}, {"status": "pass", "timing": [{"name": "compile", "started_at": "2026-11-10T08:39:50.508150Z", "completed_at": "2026-11-10T08:39:50.522331Z"}, {"name": "execute", "started_at": "2026-11-10T08:39:50.523018Z", "completed